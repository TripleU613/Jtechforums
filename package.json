{
  "name": "jtechforums-home",
  "private": true,
  "version": "2.0.0",
  "description": "The JTech Forums landing page, served at jtechforums.org/home.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:css && npm run lint:prettier",
    "lint:css": "stylelint \"src/styles/**/*.scss\"",
    "lint:prettier": "prettier --check \"src/styles/**/*.scss\" \"*.config.ts\"",
    "format": "stylelint \"src/styles/**/*.scss\" --fix && prettier --write \"src/styles/**/*.scss\" \"*.config.ts\"",
    "check": "tsc --noEmit && npm run lint && vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JTech-Forums/Jtechforums.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "firebase": "^12.5.0",
    "gsap": "^3.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "lightningcss": "^1.33.0",
    "prettier": "3.8.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6"
  }
}
